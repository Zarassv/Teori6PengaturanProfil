<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- APP BAR -->
    <TextView
        android:id="@+id/tvAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2db86f"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        android:text="@string/app_name"
        android:textColor="#08301c"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- LATIHAN 3: PENGHITUNG PEMBUKAAN APLIKASI -->
    <TextView
        android:id="@+id/tvJumlahBuka"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#f0fdf4"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#166534"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/layoutUtama"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!--  1. kartu profil  -->
            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/desc_avatar"
                android:src="@drawable/avatar_1" />

            <TextView
                android:id="@+id/tvNamaKartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/nama_default"
                android:textColor="#1B1B1B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmailKartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/email_default"
                android:textColor="#6B6B6B"
                android:textSize="14sp" />

            <!-- ===== 2. pilih avatar: ketuk langsung ===== -->
            <TextView
                android:id="@+id/tvLabelAvatar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Pilih avatar"
                android:textColor="#64748b"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAvatarOpsi1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_avatar_ring_off"
                    android:contentDescription="@string/desc_avatar"
                    android:padding="2dp"
                    android:src="@drawable/avatar_1" />

                <ImageView
                    android:id="@+id/ivAvatarOpsi2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_avatar_ring_off"
                    android:contentDescription="@string/desc_avatar"
                    android:padding="2dp"
                    android:src="@drawable/avatar_2" />

                <ImageView
                    android:id="@+id/ivAvatarOpsi3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_avatar_ring_off"
                    android:contentDescription="@string/desc_avatar"
                    android:padding="2dp"
                    android:src="@drawable/avatar_3" />
            </LinearLayout>

            <!--  3. form isian -->
            <EditText
                android:id="@+id/etNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_input_terang"
                android:backgroundTint="@null"
                android:hint="@string/label_nama"
                android:inputType="textPersonName"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_terang"
                android:backgroundTint="@null"
                android:hint="@string/label_email"
                android:inputType="textEmailAddress"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_terang"
                android:backgroundTint="@null"
                android:hint="@string/label_bio"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:padding="12dp" />

            <!-- LATIHAN 2: KOTA -->
            <EditText
                android:id="@+id/etKota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_terang"
                android:backgroundTint="@null"
                android:hint="@string/label_kota"
                android:inputType="text"
                android:padding="12dp" />

            <!--  4. sakelar mode gelap  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLabelGelap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_mode_gelap"
                    android:textColor="#1B1B1B"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swGelap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!--  5. tombol aksi  -->
            <Button
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_tombol_simpan"
                android:backgroundTint="@null"
                android:text="@string/btn_simpan"
                android:textColor="#08301c"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_tombol_ghost"
                android:backgroundTint="@null"
                android:text="@string/btn_reset"
                android:textColor="#64748b"
                android:textStyle="bold" />

            <!-- LATIHAN 1: NAMA PANGGILAN (fitur terpisah) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Latihan: Nama Panggilan"
                android:textColor="#1B1B1B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPanggilan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_terang"
                android:backgroundTint="@null"
                android:hint="@string/label_panggilan"
                android:inputType="text"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnSimpanPanggilan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tombol_ghost"
                android:backgroundTint="@null"
                android:text="@string/btn_simpan_panggilan"
                android:textColor="#64748b" />

            <TextView
                android:id="@+id/tvPanggilanHasil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/teks_panggilan_kosong"
                android:textColor="#6B6B6B"
                android:textStyle="italic" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>